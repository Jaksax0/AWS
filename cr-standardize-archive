import os
import boto3
import pandas as pd
import numpy as np
import json
import ast
import io

BUCKET          = os.environ["S3_BUCKET"]
ARCHIVE_PREFIX  = "clash-royale-archive-2020/"
CARD_STATS_KEY  = "metadata/card_stats.json"

DROP_COLS = [
    "Unnamed: 0", "arena.id", "gameMode.id", "average.startingTrophies",
    "tournamentTag",
    "winner.clan.tag", "winner.clan.badgeId",
    "loser.clan.tag",  "loser.clan.badgeId",
    "winner.cards.list", "loser.cards.list",
    "winner.troop.count", "winner.structure.count", "winner.spell.count",
    "loser.troop.count",  "loser.structure.count",  "loser.spell.count",
]

INT_COLS = [
    "winner_starting_trophies", "winner_trophy_change",
    "winner_crowns",            "winner_king_hp",
    "loser_starting_trophies",  "loser_trophy_change",
    "loser_crowns",
]


def load_card_stats(s3_client, bucket: str, key: str) -> dict[int, str]:
    raw = s3_client.get_object(Bucket=bucket, Key=key)["Body"].read()
    card_stats = json.loads(raw)
    return {v["id"]: k for k, v in card_stats.items()}


def list_parquet_files(bucket: str, prefix: str) -> list[str]:
    s3 = boto3.client("s3")
    paginator = s3.get_paginator("list_objects_v2")
    keys = []
    for page in paginator.paginate(Bucket=bucket, Prefix=prefix):
        for obj in page.get("Contents", []):
            if obj["Key"].endswith(".parquet"):
                keys.append(obj["Key"])
    return keys


def parse_tower_hps(x) -> list[int]:
    if x is None or (isinstance(x, float) and np.isnan(x)):
        return []
    if isinstance(x, str):
        try:
            return ast.literal_eval(x)
        except Exception:
            return []
    if isinstance(x, (list, np.ndarray)):
        return list(x)
    return []


def build_rename_map() -> dict[str, str]:
    m = {
        "battleTime":                    "battle_timestamp",
        "winner.tag":                    "winner_tag",
        "winner.startingTrophies":       "winner_starting_trophies",
        "winner.trophyChange":           "winner_trophy_change",
        "winner.crowns":                 "winner_crowns",
        "winner.kingTowerHitPoints":     "winner_king_hp",
        "winner.elixir.average":         "winner_avg_elixir",
        "winner.totalcard.level":        "winner_total_card_level",
        "winner.common.count":           "winner_common_count",
        "winner.rare.count":             "winner_rare_count",
        "winner.epic.count":             "winner_epic_count",
        "winner.legendary.count":        "winner_legendary_count",
        "loser.tag":                     "loser_tag",
        "loser.startingTrophies":        "loser_starting_trophies",
        "loser.trophyChange":            "loser_trophy_change",
        "loser.crowns":                  "loser_crowns",
        "loser.kingTowerHitPoints":      "loser_king_hp",
        "loser.elixir.average":          "loser_avg_elixir",
        "loser.totalcard.level":         "loser_total_card_level",
        "loser.common.count":            "loser_common_count",
        "loser.rare.count":              "loser_rare_count",
        "loser.epic.count":              "loser_epic_count",
        "loser.legendary.count":         "loser_legendary_count",
    }
    for i in range(1, 9):
        m[f"winner.card{i}.id"]    = f"winner_c{i}_id"
        m[f"winner.card{i}.level"] = f"winner_c{i}_level"
        m[f"loser.card{i}.id"]     = f"loser_c{i}_id"
        m[f"loser.card{i}.level"]  = f"loser_c{i}_level"
    return m


def build_final_column_order() -> list[str]:
    cols = ["battle_timestamp"]
    for player in ["winner", "loser"]:
        cols += [
            f"{player}_tag",
            f"{player}_starting_trophies", f"{player}_trophy_change",
            f"{player}_crowns",            f"{player}_king_hp",
            f"{player}_tower_hps",
            f"{player}_avg_elixir",        f"{player}_total_card_level",
            f"{player}_avg_card_level",
            f"{player}_evo_count",         f"{player}_hero_count",
            f"{player}_common_count",      f"{player}_rare_count",
            f"{player}_epic_count",        f"{player}_legendary_count",
            f"{player}_champion_count",
        ]
        for i in range(1, 9):
            cols += [
                f"{player}_c{i}_name",
                f"{player}_c{i}_level",
                f"{player}_c{i}_evo",
            ]
    return cols


RENAME_MAP    = build_rename_map()
FINAL_COLUMNS = build_final_column_order()


def transform_archive(df: pd.DataFrame, id_to_name: dict) -> pd.DataFrame:
    df = df.drop(columns=[c for c in DROP_COLS if c in df.columns])

    df["winner_tower_hps"] = df["winner.princessTowersHitPoints"].apply(parse_tower_hps)
    df["loser_tower_hps"]  = df["loser.princessTowersHitPoints"].apply(parse_tower_hps)
    df = df.drop(columns=["winner.princessTowersHitPoints", "loser.princessTowersHitPoints"])

    df = df.rename(columns=RENAME_MAP)

    for col in INT_COLS:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce").fillna(0).astype("int64")
    df["loser_king_hp"] = pd.to_numeric(df["loser_king_hp"], errors="coerce").fillna(0).astype("int64")
    df["battle_timestamp"] = pd.to_datetime(df["battle_timestamp"]).dt.tz_localize(None)

    for player in ["winner", "loser"]:
        df[f"{player}_avg_card_level"] = df[f"{player}_total_card_level"] / 8.0
        df[f"{player}_evo_count"]      = 0
        df[f"{player}_hero_count"]     = 0
        df[f"{player}_champion_count"] = 0
        for i in range(1, 9):
            df[f"{player}_c{i}_evo"] = 0

    for player in ["winner", "loser"]:
        for i in range(1, 9):
            df[f"{player}_c{i}_name"] = df[f"{player}_c{i}_id"].map(id_to_name)
    id_cols = [f"{p}_c{i}_id" for p in ["winner", "loser"] for i in range(1, 9)]
    df = df.drop(columns=[c for c in id_cols if c in df.columns])

    return df[[c for c in FINAL_COLUMNS if c in df.columns]]


def process_file(s3_client, bucket: str, key: str, id_to_name: dict) -> tuple[int, int]:
    buf = io.BytesIO(s3_client.get_object(Bucket=bucket, Key=key)["Body"].read())
    df  = pd.read_parquet(buf)

    df = transform_archive(df, id_to_name)

    out = io.BytesIO()
    df.to_parquet(out, index=False, engine="pyarrow")
    out.seek(0)
    s3_client.put_object(Bucket=bucket, Key=key, Body=out.getvalue())

    return df.shape


s3 = boto3.client("s3")

print("Wczytywanie card_stats.json...")
id_to_name = load_card_stats(s3, BUCKET, CARD_STATS_KEY)
print(f"  Załadowano {len(id_to_name)} kart")

files = list_parquet_files(BUCKET, ARCHIVE_PREFIX)
print(f"Znaleziono {len(files)} plików Parquet w s3://{BUCKET}/{ARCHIVE_PREFIX}")

for i, key in enumerate(files, 1):
    print(f"  [{i}/{len(files)}] Przetwarzam: {key}")
    rows, cols = process_file(s3, BUCKET, key, id_to_name)
    print(f"    → {rows:,} wierszy, {cols} kolumn")

print("Gotowe")
